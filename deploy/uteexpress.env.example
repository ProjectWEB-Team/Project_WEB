# Copy to /etc/uteexpress.env on the server (chmod 600). Never commit the real file.
UTEEXPRESS_SQLSERVER_URL=jdbc:sqlserver://<rds-endpoint>:1433;databaseName=ute_express;encrypt=true;trustServerCertificate=true
UTEEXPRESS_SQLSERVER_USERNAME=uteexpress_app
UTEEXPRESS_SQLSERVER_PASSWORD=<strong-password>
# Generate with: openssl rand -base64 48
UTEEXPRESS_JWT_SECRET=<base64-secret>
