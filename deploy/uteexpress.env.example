# Copy to /etc/uteexpress.env on the server (chmod 600). Never commit the real file.
UTEEXPRESS_SQLSERVER_URL=jdbc:sqlserver://<rds-endpoint>:1433;databaseName=ute_express;encrypt=true;trustServerCertificate=true
UTEEXPRESS_SQLSERVER_USERNAME=uteexpress_app
UTEEXPRESS_SQLSERVER_PASSWORD=<strong-password>
# Generate with: openssl rand -base64 48
UTEEXPRESS_JWT_SECRET=<base64-secret>
# prod for real use; prod,demo while testing (adds demo hubs/accounts and 2-minute timeouts).
SPRING_PROFILES_ACTIVE=prod
# Optional memory override (default in the systemd unit fits t3.micro):
#JAVA_OPTS=-Xms256m -Xmx768m -XX:MaxMetaspaceSize=192m
# Only with demo: BCrypt hash of your own demo password (see docs/DEPLOY_AWS.md, step 6).
#UTEEXPRESS_DEMO_PASSWORD_HASH=

# Optional Google login + SMTP: use SPRING_PROFILES_ACTIVE=prod,google,smtp
#UTEEXPRESS_GOOGLE_CLIENT_ID=
#UTEEXPRESS_GOOGLE_CLIENT_SECRET=
#MAIL_USERNAME=
#MAIL_PASSWORD=
# For SES or other providers whose SMTP username is not an email, set a verified sender.
#MAIL_FROM=no-reply@your-domain.example
# Gmail uses an App Password with two-step verification, never your normal password.
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587

# Optional phone OTP through SpeedSMS: add sms to SPRING_PROFILES_ACTIVE; remove otp-local.
#SPEEDSMS_ACCESS_TOKEN=
#SPEEDSMS_SENDER=Verify
#SPEEDSMS_MESSAGE_TEMPLATE=UTEExpress: Ma xac thuc cua ban la {code}. Hieu luc {minutes} phut. Khong chia se ma nay.
