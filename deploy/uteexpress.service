# /etc/systemd/system/uteexpress.service
[Unit]
Description=UTEExpress web
After=network-online.target
Wants=network-online.target

[Service]
User=uteexpress
WorkingDirectory=/opt/uteexpress
EnvironmentFile=/etc/uteexpress.env
ExecStart=/usr/bin/java -Xms256m -Xmx768m -jar /opt/uteexpress/app.war --spring.profiles.active=prod --server.address=127.0.0.1
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
